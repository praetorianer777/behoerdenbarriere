DATABASE_URL=postgres://behoerdenbarriere:behoerdenbarriere@localhost:5432/behoerdenbarriere?sslmode=disable
CHROME_URL=http://localhost:9222
API_ADDR=:8080
API_KEY=change-me
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

CRAWL_MAX_PAGES=100
CRAWL_MAX_DEPTH=3
CRAWL_RATE_PER_SEC=1
CRAWL_TIMEOUT=10m
SCAN_PAGE_TIMEOUT=30s
SCAN_CONCURRENCY=4

WORKER_POLL_INTERVAL=5s
RESCAN_INTERVAL=168h

# OpenTelemetry stays off until an endpoint is set. With `make dev-telemetry` the
# collector listens on otel-collector:4317 (grpc) and :4318 (http/protobuf).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER_ARG=1
